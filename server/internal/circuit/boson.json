      "steps": [
        {
          "id": "prepare",
          "title": {
            "en": "Find the power board",
            "zh": "找到电源板"
          },
          "instruction": {
            "en": "Keep the m2 switch OFF. Lay out the modules with their markings visible.",
            "zh": "将 m2 开关保持在 OFF，摆好元件，让编号朝上。"
          },
          "placement_ids": [
            "power"
          ]
        },
        {
          "id": "place-input",
          "title": {
            "en": "Find the input module",
            "zh": "找到输入模块"
          },
          "instruction": {
            "en": "Find BOS0002-R (i2r) and place it as shown. The diagram shows connections, not a mounting scale.",
            "zh": "找到 BOS0002-R（i2r），按图摆放。示意图表示连接关系，不是安装尺寸。"
          },
          "placement_ids": [
            "input"
          ]
        },
        {
          "id": "place-output",
          "title": {
            "en": "Find the output module",
            "zh": "找到输出模块"
          },
          "instruction": {
            "en": "Find BOS0017-R (o2r) and place it as shown. The diagram shows connections, not a mounting scale.",
            "zh": "找到 BOS0017-R（o2r），按图摆放。示意图表示连接关系，不是安装尺寸。"
          },
          "placement_ids": [
            "output"
          ]
        },
        {
          "id": "connect-1",
          "title": {
            "en": "Connect cable 1",
            "zh": "连接第 1 根线"
          },
          "instruction": {
            "en": "With power OFF, connect i2r OUT to m2 IN using a 10 cm BOSON cable. Follow the printed socket arrows.",
            "zh": "保持断电，用一根 10 厘米 BOSON 线连接 i2r OUT 和 m2 IN，核对实物插口箭头。"
          },
          "placement_ids": [
            "cable1"
          ]
        },
        {
          "id": "connect-2",
          "title": {
            "en": "Connect cable 2",
            "zh": "连接第 2 根线"
          },
          "instruction": {
            "en": "With power OFF, connect m2 OUT to o2r IN using a 10 cm BOSON cable. Follow the printed socket arrows.",
            "zh": "保持断电，用一根 10 厘米 BOSON 线连接 m2 OUT 和 o2r IN，核对实物插口箭头。"
          },
          "placement_ids": [
            "cable2"
          ]
        },
        {
          "id": "power-last",
          "title": {
            "en": "Connect power last",
            "zh": "最后连接电源"
          },
          "instruction": {
            "en": "Ask an adult to check every connection and battery direction. Connect the matching 3×AAA holder to m2 USB. Turn ON only when ready to try.",
            "zh": "请成人检查全部连接和电池方向，把配套三节 AAA 电池盒接入 m2 的 USB 口，准备试验时才拨到 ON。"
          },
          "placement_ids": [
            "battery"
          ]
        }
      ],
      "expected_nets": [
        [
          "input:OUT",
          "power:IN"
        ],
        [
          "power:OUT",
          "output:IN"
        ],
        [
          "battery:USB",
          "power:USB"
        ]
      ],
      "connections": [
        {
          "id": "link1",
          "from": "input:OUT",
          "to": "power:IN",
          "cable_id": "cable1"
        },
        {
          "id": "link2",
          "from": "power:OUT",
          "to": "output:IN",
          "cable_id": "cable2"
        },
        {
          "id": "battery-lead",
          "from": "battery:USB",
          "to": "power:USB"
        }
      ]
    },
    {
      "id": "boson-inverted-light",
      "title": {
        "en": "The opposite lamp",
        "zh": "反着来的小灯"
      },
      "description": {
        "en": "Add NOT: release the button to light the LED, press to turn it off.",
        "zh": "加入非逻辑模块：松开按钮亮灯，按住反而熄灭。"
      },
      "explanation": {
        "en": "NOT reverses the button signal. Follow its input-to-output arrow when inserting it after m2.",
        "zh": "非逻辑模块反转按钮信号，接在 m2 后方时要按箭头区分输入和输出。"
      },
      "test_instruction": {
        "en": "Turn ON. Compare the light with the button released and pressed. Repeat three times, then switch OFF.",
        "zh": "打开开关，比较松开和按住按钮时灯的状态，重复三次后关闭电源。"
      },
      "troubleshooting": [
        {
          "en": "Turn the m2 switch OFF before adjusting plugs. Check the printed IDs and arrows against the complete diagram.",
          "zh": "调整插头前先将 m2 关闭，对照完整图检查印刷编号和箭头。"
        },
        {
          "en": "Check the matching battery holder, battery directions and fully seated keyed plugs. Ask an adult if the expected response does not appear.",
          "zh": "检查配套电池盒、电池方向和插头是否插到位，未出现预期现象时请成人帮助。"
        }
      ],
