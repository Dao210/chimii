  "projects": [
    {
      "id": "boson-button-light",
      "title": {
        "en": "Press to light",
        "zh": "按住就亮的小灯"
      },
      "description": {
        "en": "Press the red button to light the LED; release to turn it off.",
        "zh": "按住红色按钮让小灯亮起，松开熄灭。"
      },
      "explanation": {
        "en": "The button sends a signal through m2 to the LED. The keyed cables also carry the supply connections.",
        "zh": "按钮通过 m2 向灯传递信号，配套连接线同时包含供电连接。"
      },
      "test_instruction": {
        "en": "Turn ON, press and release the button three times. Check that the LED follows each press and release. Switch OFF when finished.",
        "zh": "打开开关，按下和松开按钮三次，观察灯是否每次随之亮灭，结束后关闭电源。"
      },
      "troubleshooting": [
        {
          "en": "Turn the m2 switch OFF before adjusting plugs. Check the printed IDs and arrows against the complete diagram.",
          "zh": "调整插头前先将 m2 关闭，对照完整图检查印刷编号和箭头。"
        },
        {
          "en": "Check the matching battery holder, battery directions and fully seated keyed plugs. Ask an adult if the expected response does not appear.",
          "zh": "检查配套电池盒、电池方向和插头是否插到位，未出现预期现象时请成人帮助。"
        }
      ],
      "source": {
        "url": "https://dfimg.dfrobot.com/nobody/wiki/9e1deee4de0662f547d6f98283f7eacd.pdf",
        "title": "DFRobot EDU0080-EN Quick Start Guide",
        "page": 10,
        "sha256": "ea388d4527598e6546ac64150cbe6280be2888168eff87d7cf2b0527f1470fb4"
      },
