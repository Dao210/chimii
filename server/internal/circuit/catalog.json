  "projects": [
    {
      "id": "switch-light",
      "title": {
        "en": "A light of my own",
        "zh": "我的第一盏灯"
      },
      "description": {
        "en": "Make a lamp turn on and off.",
        "zh": "用一个开关，让小灯泡亮起来。"
      },
      "explanation": {
        "en": "The lamp and switch form a loop with the battery. Opening the switch breaks the loop.",
        "zh": "电池、灯泡和开关连成一圈。开关断开时，通路中断，灯就熄灭。"
      },
      "test_instruction": {
        "en": "With an adult, check the complete diagram, then turn S1 on briefly and off again. Does L1 light up and go out?",
        "zh": "和大人一起核对完整搭建图，再短暂打开 S1，然后关上。L1 是否亮起又熄灭？"
      },
      "troubleshooting": [
        {
          "en": "Switch off before checking. Match every snap and layer, then check the batteries with an adult.",
          "zh": "先关开关再检查。逐一核对扣点和层次，再和大人一起检查电池。"
        }
      ],
