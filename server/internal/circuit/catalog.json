    {
      "id": "alarm-sound",
      "title": {
        "en": "My little alarm",
        "zh": "我的小小报警器"
      },
      "description": {
        "en": "Connect a sound module and hear its alarm.",
        "zh": "把报警模块和扬声器连接起来。"
      },
      "explanation": {
        "en": "U2 generates a changing signal. The speaker turns it into sound; S1 controls the circuit.",
        "zh": "U2 产生变化的信号，扬声器把它变成声音，S1 控制电路开关。"
      },
      "test_instruction": {
        "en": "Check the diagram with an adult. Keep the speaker away from ears, briefly turn S1 on, then off.",
        "zh": "和大人核对搭建图。扬声器远离耳朵，短暂打开 S1 听一听，再关上。"
      },
      "troubleshooting": [
        {
          "en": "Switch off. Check IN2, OUT and the minus terminal on U2 against the drawing.",
          "zh": "先关开关。对照图检查 U2 的 IN2、OUT 和负极接点。"
        }
